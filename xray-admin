#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
[[ $EUID -eq 0 ]] || { echo '请用 root 执行'; exit 1; }
state=/usr/local/etc/xray/client.json
sub_token_file=/etc/xray-sub/token
sub_port_file=/etc/xray-sub/port
sub_rules=/etc/xray-sub/rules.yaml
plan_file=/etc/xray-sub/provider-plan

show_plan() {
  [[ -f $plan_file ]] || { echo '套餐信息：未记录（可在下次一键部署时填写）'; return 1; }
  local total reset expire
  total=$(sed -n 's/^total_display=//p' "$plan_file")
  reset=$(sed -n 's/^reset_day=//p' "$plan_file")
  expire=$(sed -n 's/^expire_date=//p' "$plan_file")
  echo "月流量：${total:-未记录}"
  case ${reset:-0} in
    0) echo '重置日：无固定重置日';;
    *) echo "重置日：每月 ${reset} 日";;
  esac
  if [[ ${expire:-0} == 0 ]]; then
    echo '到期日：长期有效'
  else
    echo "到期日：${expire}"
  fi
}

sub_url() {
  [[ -f $state && -s $sub_token_file ]] || { echo '尚未配置订阅'; return 1; }
  local server publicp token sport
  server=$(jq -er .server "$state")
  token=$(tr -d '\r\n' < "$sub_token_file")
  sport=$(tr -d '\r\n' < "$sub_port_file" 2>/dev/null || echo 2096)
  publicp=$(tr -d '\r\n' < /etc/xray-sub/public_port 2>/dev/null || echo "$sport")
  printf 'http://%s:%s/cgi-bin/%s\n' "$server" "${SUB_PUBLIC_PORT:-$publicp}" "$token"
}

show_sub() {
  echo
  echo '订阅地址（复制到 FlClash 订阅栏）：'
  sub_url || return 1
  echo
  echo "规则文件：$sub_rules"
  if [[ -f $sub_rules ]]; then
    printf '通用规则：%s 条\n' "$(grep -c '^- ' "$sub_rules" 2>/dev/null || echo 0)"
  fi
  echo '私有规则：请保存在 FlClash 本地覆写（不由 VPS 下发）'
  show_plan || true
  echo '注意：HTTP 订阅链接中的令牌控制访问，但不加密传输。'
  systemctl is-active --quiet xray-sub && echo '订阅服务：运行中' || echo '订阅服务：未运行'
}

# One self-contained file a user can keep and reuse on any new computer.
export_sub_info() {
  local out=/root/xray-subscription.txt
  {
    echo '# 个人 Xray 订阅信息'
    echo "# 生成时间：$(date -u '+%Y-%m-%d %H:%M UTC')"
    echo
    echo '## 订阅地址（粘到 FlClash 的订阅栏）'
    sub_url
    echo
    echo '## 端口'
    echo "代理公网端口：$(jq -er .port "$state" 2>/dev/null || echo 未知)"
    echo "订阅公网端口：$(tr -d '\r\n' </etc/xray-sub/public_port 2>/dev/null || echo 2096)"
    echo
    echo '## 私有规则'
    echo '请从 FlClash 本地备份恢复，不由 VPS 保存或发布。'
    echo
    echo '## 套餐信息'
    show_plan || true
    echo
    echo '## 说明'
    echo '这个文件含订阅地址，等同凭据。只存在自己的电脑上，不要公开。'
    echo '换电脑：导入订阅，再从自己的私有备份恢复 FlClash 本地覆写。'
    echo '换 VPS：部署后更新订阅地址，本地覆写继续使用，不应上传到公开仓库。'
  } > "$out"
  chmod 600 "$out"
  echo "已生成：$out"
  echo '请下载到自己电脑保存，重装系统会删除。'
}

export_node() {
  [[ -f $state ]] || { echo '找不到安装状态文件'; return 1; }
  install -d -m 700 /root/xray-client
  jq '{proxies:[{name:"Personal-VPS",type:"vless",server:.server,port:.port,uuid:.uuid,network:"tcp",tls:true,udp:true,flow:"xtls-rprx-vision","client-fingerprint":"chrome",servername:.server_name,"reality-opts":{"public-key":.public_key,"short-id":.short_id}}]}' "$state" > /root/xray-client/node.json
  chmod 600 /root/xray-client/node.json
  echo '已导出 /root/xray-client/node.json'
}

edit_rules() {
  local target="${1:-$sub_rules}"
  local backup
  backup="/root/xray-sub-rules-$(date -u +%Y%m%dT%H%M%SZ)-$(basename "$target")"
  [[ -f $target ]] || {
    echo "文件不存在：$target"
    return 1
  }
  cp -p "$target" "$backup"
  chmod 600 "$backup"
  echo "已备份到 $backup"
  "${EDITOR:-nano}" "$target" || { echo '编辑器退出异常'; return 1; }
  if /usr/local/sbin/xray-sub; then
    echo '已重新生成订阅，FlClash 里下拉刷新即可'
  else
    echo '生成失败，正在回滚'
    cp -p "$backup" "$target"
    return 1
  fi
}

backup_all() {
  local file
  file=/root/xray-backup-$(date -u +%Y%m%dT%H%M%SZ).tar.gz
  local paths=(usr/local/etc/xray usr/local/sbin/xray-admin usr/local/sbin/xray-sub etc/xray-sub etc/systemd/system/xray.service etc/systemd/system/xray-sub.service usr/local/bin/xray usr/local/share/xray/geoip.dat srv/sub)
  local existing=()
  for p in "${paths[@]}"; do [[ -e /$p ]] && existing+=("$p"); done
  tar -czf "$file" -C / "${existing[@]}"
  chmod 600 "$file"
  echo "备份：$file"
  echo '请下载到自己电脑，重装会删除服务器内备份'
}

set_quota() {
  local f=/etc/xray-sub/userinfo backup="" tmp
  echo '设置订阅里显示的流量额度。Clash 会读取这些值显示用量。'
  echo '这是手动快照，不自动统计、限流或按月重置；expire 是套餐到期，不是重置日。'
  echo '留空使用 0；total=0 是否显示无限取决于客户端。真实余额请核对供应商后台。'
  local up down total expire plan_total=0 plan_expire=0
  if [[ -f $plan_file ]]; then
    plan_total=$(sed -n 's/^total_bytes=//p' "$plan_file")
    plan_expire=$(sed -n 's/^expire_epoch=//p' "$plan_file")
  fi
  plan_total=${plan_total:-0}; plan_expire=${plan_expire:-0}
  read -r -p '已上传字节数 [0]: ' up; up=${up:-0}
  read -r -p '已下载字节数 [0]: ' down; down=${down:-0}
  read -r -p "总流量字节数（0=不限，100GB=107374182400） [${plan_total}]: " total; total=${total:-$plan_total}
  read -r -p "到期时间（Unix 时间戳，0=长期有效） [${plan_expire}]: " expire; expire=${expire:-$plan_expire}
  for v in "$up" "$down" "$total" "$expire"; do
    [[ $v =~ ^[0-9]+$ ]] || { echo '只接受非负整数'; return 1; }
  done
  if [[ -f $f ]]; then
    backup=$(mktemp)
    cp -p "$f" "$backup" || { rm -f "$backup"; echo '无法备份现有额度'; return 1; }
  fi
  tmp=$(mktemp)
  printf 'upload=%s; download=%s; total=%s; expire=%s\n' "$up" "$down" "$total" "$expire" > "$tmp"
  if ! chown root:xray-sub "$tmp" || ! chmod 640 "$tmp"; then
    rm -f "$tmp" "$backup"
    echo '无法设置额度文件权限'
    return 1
  fi
  mv -f "$tmp" "$f"
  if ! /usr/local/sbin/xray-sub >/dev/null; then
    if [[ -n $backup ]]; then cp -p "$backup" "$f"; else rm -f "$f"; fi
    rm -f "$backup"
    echo '重新生成失败，已恢复原额度设置'
    return 1
  fi
  rm -f "$backup"
  echo '已保存。Clash 下拉刷新订阅即可看到额度。'
}

check_config() { XRAY_LOCATION_ASSET=/usr/local/share/xray /usr/local/bin/xray run -test -config /usr/local/etc/xray/config.json; }

change_sub_port() {
  local current proxy_public internal new
  current=$(tr -d '\r\n' </etc/xray-sub/public_port 2>/dev/null || echo 2096)
  proxy_public=$(jq -er .port "$state" 2>/dev/null || true)
  echo "当前订阅公网端口：$current"
  internal=$(cat "$sub_port_file") || return 1
  echo "只改对外地址，内部仍监听 $internal；平台映射由你自行配置。"
  read -r -p '新的订阅公网端口（回车保持不变）: ' new
  if [[ -z $new ]]; then echo '未修改'; return 0; fi
  [[ $new =~ ^[1-9][0-9]{0,4}$ ]] || { echo '端口格式不正确'; return 1; }
  ((10#$new <= 65535)) || { echo '端口超出范围'; return 1; }
  if [[ -n $proxy_public && $new == "$proxy_public" ]]; then
    echo '订阅公网端口不能与代理公网端口相同'
    return 1
  fi
  if [[ $new == "$current" ]]; then echo '未修改'; return 0; fi
  printf '%s\n' "$new" > /etc/xray-sub/public_port
  echo "已保存。新的订阅地址："
  sub_url
}

case ${1:-} in
  --export) export_node; exit;;
  --sub) show_sub; exit;;
  --plan) show_plan; exit;;
esac

while true; do
  cat <<'MENU'

个人 Xray 管理
  1. 状态、端口与内存
  2. 最近日志
  3. 检查配置并重启
  4. 查看订阅地址
  5. 编辑通用规则（rules.yaml）
  6. 私有规则迁移说明（FlClash 本地覆写）
  7. 重新生成订阅
  8. 修改订阅公网端口
  9. 设置流量额度（客户端显示）
 10. 导出订阅信息到文件（换电脑用）
 11. 备份
  12. 导出客户端节点
  13. 套餐信息（月流量/重置日/到期日）
  0. 退出
MENU
  read -r -p '选择: ' option || exit 0
  case $option in
    1) systemctl --no-pager --full status xray || true
       ss -lntp
       systemctl show xray -p MemoryCurrent -p MemoryMax 2>/dev/null || true
       free -m;;
    2) journalctl -u xray -n 40 --no-pager || echo '日志读取失败';;
    3) if check_config; then
         if systemctl restart xray; then
           sleep 2
           systemctl is-active xray || echo 'Xray 未运行，请查看日志'
         else
           echo '重启失败，请查看日志'
         fi
       else
         echo '配置检查失败，未重启'
       fi;;
    4) show_sub || echo '订阅状态读取失败';;
    5) edit_rules "$sub_rules" || echo '规则未更新，原文件已保留或恢复';;
    6) echo '私有设备规则应在 FlClash 本地覆写中添加并备份；不在 VPS 创建或发布。';;
    7) /usr/local/sbin/xray-sub && echo '已重新生成，FlClash 下拉刷新即可' || echo '生成失败，请检查规则';;
    8) change_sub_port || echo '端口未修改';;
    9) set_quota || echo '额度未成功更新';;
    10) export_sub_info || echo '导出失败';;
    11) backup_all || echo '备份失败，请检查磁盘';;
    12) export_node || echo '导出失败';;
    13) show_plan || echo '未记录套餐信息（可在下次一键部署时填写）';;
    0) exit 0;;
    *) echo '无效选项';;
  esac
done
