[Unit]
Description=Personal Clash subscription (static)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# Must bind 0.0.0.0: the platform forwards to the instance NIC address, so a
# 127.0.0.1-only listener is unreachable and the forwarder returns 502.
# Access control is the random token in the path, not the bind address.
ExecStart=__BUSYBOX__ httpd -f -p 0.0.0.0:__SUB_PORT__ -h /srv/sub
Restart=always
RestartSec=5
# A dedicated system user, not "nobody" (systemd flags that as unsafe).
User=xray-sub
Group=xray-sub
# No mount namespaces: nested Podman/LXC hosts reject them (status 226/NAMESPACE).
NoNewPrivileges=true
CapabilityBoundingSet=
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
